# Copy to .env and fill in your own values. No keys — auth is DefaultAzureCredential.
# Run `az login` first so the credential can resolve your identity.

# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<your-service>.search.windows.net
SEARCH_INDEX=kb-index

# --- Azure OpenAI / Foundry (embeddings + LLM-judge evaluators) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1

# --- Foundry project (grounded agents, Ch. 12) ---
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
SEARCH_CONNECTION_NAME=<search-connection-name-in-the-project>
SEARCH_INDEX_NAME=kb-index
